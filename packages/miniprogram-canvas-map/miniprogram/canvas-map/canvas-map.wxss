.canvas-map {
  position: relative;
  width: 100%;
  height: 100%;
}

.canvas-map__status {
  position: absolute;
  left: 18rpx;
  top: 16rpx;
  z-index: 2;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #596258;
  font-size: 22rpx;
}

.canvas-map__reset {
  position: absolute;
  right: 18rpx;
  top: 16rpx;
  z-index: 2;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(29, 36, 51, 0.88);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.canvas-map__canvas {
  display: block;
  width: 100%;
  height: 100%;
  background: transparent;
}

.canvas-map__loading {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(29, 36, 51, 0.72);
}

.canvas-map__loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8ecae6;
  animation: canvas-map-pulse 1s ease-in-out infinite;
}

.canvas-map__loading-text {
  color: #ffffff;
  font-size: 20rpx;
}

@keyframes canvas-map-pulse {
  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.85);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}
